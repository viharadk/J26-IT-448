# ─── Mobile Environment Variables ────────────────────────────────────────────
#
# Copy this file to .env.local and fill in your backend IP address.
# .env.local is gitignored — never commit it.
#
# How to find your laptop's LAN IP:
#   Windows:  Run  ipconfig  in PowerShell or CMD.
#             Look for "IPv4 Address" under your Wi-Fi adapter.
#             Example: 192.168.1.42
#
# Important: Do NOT use "localhost" here.
# On a physical phone, localhost refers to the phone itself, not your laptop.
#
# After editing this file, restart Expo:  npx expo start --clear
# ─────────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_API_URL=http://YOUR_LAPTOP_LAN_IP:3000

