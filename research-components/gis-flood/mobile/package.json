{
  "name": "kelani-floodwatch-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/api.test.ts tests/flood.test.ts tests/analysis.test.ts tests/search.test.ts tests/sar.test.ts tests/sarWorkflow.test.ts tests/population.test.ts tests/populationNavigation.test.ts tests/function1.test.ts tests/mobilePolish.test.ts tests/mobileCleanup.test.ts",
    "test:api": "tsx --env-file=.env scripts/check-api.ts",
    "test:gis": "tsx --env-file=.env scripts/check-gis.ts",
    "test:analysis": "tsx --env-file=.env scripts/check-analysis.ts",
    "test:search": "tsx --env-file=.env scripts/check-search.ts",
    "check:expo": "expo install --check"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "expo": "~53.0.27",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "@types/node": "^22.0.0",
    "typescript": "~5.8.3",
    "tsx": "^4.20.0"
  }
}
